:root {
  --bg: #f5f7fb;
  --surface: #ffffff;
  --text: #162033;
  --muted: #657089;
  --line: #dfe4ee;
  --primary: #315efb;
  --primary-dark: #2449c8;
  --soft: #eef3ff;
  --success: #1f8b5b;
  --warning: #a36b00;
  --shadow: 0 18px 50px rgba(31, 44, 74, 0.08);
  --radius: 18px;
  --shell: min(1120px, calc(100% - 32px));
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(49, 94, 251, 0.08), transparent 28%),
    radial-gradient(circle at top right, rgba(31, 139, 91, 0.06), transparent 24%),
    var(--bg);
  line-height: 1.5;
}

a { color: inherit; }
button, input, select, textarea { font: inherit; }

.shell { width: var(--shell); margin: 0 auto; }
.site-header {
  position: sticky; top: 0; z-index: 20;
  backdrop-filter: blur(14px);
  background: rgba(245, 247, 251, 0.85);
  border-bottom: 1px solid rgba(223, 228, 238, 0.8);
}
.header-inner, .footer-inner {
  display: flex; align-items: center; justify-content: space-between;
  min-height: 72px; gap: 16px;
}
.brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
.brand-mark {
  width: 42px; height: 42px; border-radius: 12px;
  display: grid; place-items: center;
  background: linear-gradient(145deg, #315efb, #5b8cff);
  color: #fff; font-weight: 800;
}
.brand strong { display: block; font-size: 1rem; }
.brand small { color: var(--muted); font-size: 0.78rem; }
.status-pill {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 12px; border-radius: 999px;
  background: #fff; border: 1px solid var(--line);
  color: var(--muted); font-size: 0.78rem; font-weight: 700;
}
.page { padding: 28px 0 64px; }
.hero { margin-bottom: 22px; }
.eyebrow {
  display: inline-block; margin-bottom: 10px;
  color: var(--primary); font-size: 0.76rem; font-weight: 800; letter-spacing: 0.08em;
}
h1 {
  margin: 0 0 10px; font-size: clamp(1.8rem, 3vw, 2.6rem);
  line-height: 1.15; letter-spacing: -0.03em;
}
.hero-copy { max-width: 720px; margin: 0; color: var(--muted); font-size: 1.02rem; }
.privacy-note {
  display: flex; gap: 12px; align-items: flex-start;
  margin: 18px 0 22px; padding: 14px 16px;
  background: #eef8f3; border: 1px solid #cfe9db; border-radius: 14px;
}
.privacy-icon {
  flex: 0 0 28px; height: 28px; border-radius: 999px;
  display: grid; place-items: center; background: #1f8b5b; color: #fff; font-weight: 800;
}
.privacy-note strong { display: block; margin-bottom: 2px; }
.privacy-note p { margin: 0; color: #3d5a4c; font-size: 0.92rem; }
.workspace {
  display: grid; grid-template-columns: 1.4fr 0.8fr; gap: 18px; margin-bottom: 18px;
}
.card {
  background: var(--surface); border: 1px solid var(--line);
  border-radius: var(--radius); box-shadow: var(--shadow); padding: 22px;
}
.card-heading {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: 12px; margin-bottom: 16px;
}
.section-kicker {
  display: block; margin-bottom: 4px;
  color: var(--primary); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em;
}
h2 { margin: 0; font-size: 1.2rem; letter-spacing: -0.02em; }
.mini-note { color: var(--muted); font-size: 0.78rem; font-weight: 700; }
.dropzone {
  display: grid; place-items: center; gap: 6px; text-align: center;
  min-height: 170px; padding: 22px; border: 1.5px dashed #c5cee0;
  border-radius: 16px; background: #fbfcff; cursor: pointer; transition: 0.15s ease;
}
.dropzone:hover, .dropzone.is-dragover {
  border-color: var(--primary); background: var(--soft);
}
.dropzone input { display: none; }
.upload-icon {
  width: 42px; height: 42px; border-radius: 12px;
  display: grid; place-items: center; background: var(--soft); color: var(--primary); font-weight: 800;
}
.dropzone-title { font-weight: 800; }
.dropzone-subtitle { color: var(--muted); font-size: 0.88rem; }
.file-list-wrap { margin-top: 16px; }
.list-heading {
  display: flex; justify-content: space-between; margin-bottom: 8px;
  font-size: 0.82rem; font-weight: 800; color: var(--muted);
}
.file-list { display: grid; gap: 8px; }
.empty-state, .empty-preview {
  color: var(--muted); font-size: 0.9rem; padding: 12px;
  border: 1px dashed var(--line); border-radius: 12px; background: #fafbfe;
}
.file-item {
  display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center;
  padding: 10px 12px; border: 1px solid var(--line); border-radius: 12px; background: #fff;
}
.file-item strong { display: block; font-size: 0.92rem; }
.file-item span { color: var(--muted); font-size: 0.78rem; }
.action-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
.button {
  border: 0; border-radius: 12px; min-height: 44px; padding: 0 16px;
  font-weight: 800; cursor: pointer; transition: 0.15s ease;
}
.button:disabled { opacity: 0.45; cursor: not-allowed; }
.button.primary { background: var(--primary); color: #fff; }
.button.primary:hover:not(:disabled) { background: var(--primary-dark); }
.button.secondary {
  background: #fff; color: var(--text); border: 1px solid var(--line);
}
.button.secondary:hover:not(:disabled) { background: #f7f9fc; }
.status-message {
  margin-top: 12px; min-height: 1.2em; font-size: 0.88rem; color: var(--muted);
}
.status-message.success { color: var(--success); }
.status-message.error { color: #b42318; }
.mode-list { display: grid; gap: 10px; }
.mode-item {
  display: flex; gap: 12px; padding: 12px; border-radius: 14px;
  border: 1px solid var(--line); background: #fbfcff;
}
.mode-item.active { border-color: #c9d6ff; background: var(--soft); }
.mode-number {
  flex: 0 0 34px; height: 34px; border-radius: 10px;
  display: grid; place-items: center; background: #fff; color: var(--primary); font-weight: 900; font-size: 0.78rem;
}
.mode-item strong { display: block; margin-bottom: 2px; }
.mode-item p { margin: 0; color: var(--muted); font-size: 0.86rem; }
.ai-card, .generate-card, .preview-card { margin-top: 18px; }
.model-intro { margin: 0 0 14px; color: var(--muted); font-size: 0.92rem; }
.settings-grid, .generator-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
}
.generator-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.field label, .field-label {
  display: block; font-size: 0.78rem; font-weight: 800; margin-bottom: 7px;
}
.field input, .field select {
  width: 100%; min-height: 44px; border: 1px solid var(--line);
  border-radius: 11px; background: #fff; color: var(--text); padding: 0 12px; outline: none;
  box-sizing: border-box;
}
.field { min-width: 0; }
.ai-card .settings-grid { grid-template-columns: 1fr 1fr; }
.field input:focus, .field select:focus {
  border-color: var(--primary); box-shadow: 0 0 0 3px rgba(49, 94, 251, 0.1);
}
.api-key-row {
  display: flex;
  gap: 8px;
  align-items: stretch;
  min-width: 0;
}
.api-key-row input {
  flex: 1 1 auto;
  min-width: 0;
  width: 100%;
}
.api-key-row .small-button {
  flex: 0 0 auto;
  white-space: nowrap;
}

.dual-key-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 14px;
  min-width: 0;
}
.dual-key-grid .field {
  min-width: 0;
}

.keys-status {
  min-height: 44px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: #f8fafc;
  color: var(--muted);
  font-size: 0.86rem;
  font-weight: 600;
}

.provider-help-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 14px;
}
.provider-help-grid .provider-help {
  margin-top: 0;
}
.provider-help p {
  overflow-wrap: anywhere;
  word-break: break-word;
}
.provider-help code {
  word-break: break-all;
}
.provider-help {
  margin-top: 14px; border: 1px solid var(--line); border-radius: 13px;
  background: #fbfcff; padding: 12px 14px;
}
.provider-help strong { font-size: 0.85rem; }
.provider-help p { margin: 2px 0 5px; color: var(--muted); font-size: 0.8rem; }
.provider-help a { color: var(--primary); font-size: 0.79rem; font-weight: 800; text-decoration: none; }
.provider-help a:hover { text-decoration: underline; }
.provider-help code {
  font-size: 0.76rem; background: #eef1f6; padding: 2px 5px; border-radius: 5px;
}
.storage-note, .privacy-mini {
  display: flex; align-items: center; gap: 7px; color: var(--muted);
  font-size: 0.76rem; margin-top: 11px;
}
.storage-note .dot, .privacy-mini span:first-child { color: var(--success); }
.generator-grid { align-items: end; }
.custom-topic-field { grid-column: 1 / -1; }
.topic-hint { margin-top: 10px; color: var(--muted); font-size: 0.78rem; }
.progress, .progress-bar {
  height: 5px; overflow: hidden; background: #e8ecf4; border-radius: 99px; margin-top: 8px;
}
.progress-track { height: 100%; }
.progress-fill, .progress-bar span {
  display: block; height: 100%; width: 0; background: var(--primary); transition: width 0.2s ease;
}
.output-card { margin-top: 22px; }
.output-actions {
  display: flex; align-items: center; gap: 9px; flex-wrap: wrap; justify-content: flex-end;
}
.small-button { min-height: 36px; padding: 0 11px; font-size: 0.76rem; }
.flashcard-shell { perspective: 1200px; }
.flashcard {
  display: grid; border: 0; padding: 0; width: 100%; min-height: 300px;
  background: transparent; text-align: left; perspective: 1200px;
}
.flashcard-face {
  grid-area: 1 / 1; display: flex; flex-direction: column; gap: 10px;
  padding: 22px; border-radius: 18px; border: 1px solid var(--line);
  background: #fff; backface-visibility: hidden; transition: transform 0.45s ease;
}
.flashcard-front { transform: rotateY(0deg); }
.flashcard-back { transform: rotateY(180deg); background: #f7f9ff; }
.flashcard.is-flipped .flashcard-front { transform: rotateY(180deg); }
.flashcard.is-flipped .flashcard-back { transform: rotateY(360deg); }
.face-label {
  font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; color: var(--primary);
}
.flashcard-controls, .rating-row, .exam-actions {
  display: flex; gap: 10px; align-items: center; justify-content: center; margin-top: 14px; flex-wrap: wrap;
}
.card-position { min-width: 72px; text-align: center; font-weight: 800; color: var(--muted); }
.card-stats { margin-top: 12px; text-align: center; color: var(--muted); font-size: 0.86rem; }
.preview {
  max-height: 320px; overflow: auto; padding: 14px;
  border: 1px solid var(--line); border-radius: 14px; background: #fbfcff;
  white-space: pre-wrap; font-size: 0.9rem;
}
.summary-section {
  margin-bottom: 16px; padding: 16px; border: 1px solid var(--line); border-radius: 14px; background: #fff;
}
.summary-section h3 { margin: 0 0 10px; font-size: 1.05rem; }
.summary-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
.summary-box {
  padding: 10px 12px; border-radius: 12px; background: #f7f9fc; border: 1px solid #e7ecf5;
}
.summary-box h4 { margin: 0 0 6px; font-size: 0.82rem; color: var(--primary); }
.summary-box ul, .self-check ol { margin: 0; padding-left: 18px; }
.self-check { margin-top: 12px; }
.exam-intro { margin-bottom: 12px; color: var(--muted); font-size: 0.9rem; }
.exam-form { display: grid; gap: 14px; }
.exam-question {
  border: 1px solid var(--line); border-radius: 14px; padding: 17px; margin: 0; min-width: 0;
}
.exam-question legend { width: 100%; padding: 0; margin-bottom: 13px; }
.question-number {
  display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 9px;
  background: var(--soft); color: var(--primary); font-size: 0.72rem; font-weight: 900;
  margin-right: 8px; vertical-align: middle;
}
.question-type {
  display: inline-block; margin-right: 8px; color: var(--muted);
  font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em;
  vertical-align: middle;
}
.question-text { display: inline; font-weight: 700; }
.question-options { display: grid; gap: 8px; }
.choice-option {
  display: grid; grid-template-columns: auto 28px 1fr; gap: 9px; align-items: center;
  border: 1px solid var(--line); border-radius: 11px; padding: 10px 11px;
  cursor: pointer; background: #fff;
}
.choice-option:hover { border-color: #bcc8e1; background: #fbfcff; }
.choice-option input { width: 16px; height: 16px; margin: 0; }
.choice-marker {
  width: 28px; height: 28px; display: grid; place-items: center; border-radius: 8px;
  background: #eef1f6; color: var(--muted); font-size: 0.7rem; font-weight: 900;
}
.choice-option input:checked + .choice-marker { background: var(--primary); color: #fff; }
.answer-input {
  width: 100%; border: 1px solid var(--line); border-radius: 11px;
  padding: 11px 12px; color: var(--text); background: #fff; outline: none; resize: vertical;
}
.exam-results { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line); }
.score-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;
}
.score-label { display: block; color: var(--muted); font-size: 0.78rem; font-weight: 700; }
.score-row strong { font-size: 1.4rem; }
.weak-topics, .answer-review { display: grid; gap: 8px; }
.weak-topic, .review-item {
  padding: 10px 12px; border-radius: 12px; border: 1px solid var(--line); background: #fbfcff;
}
.exam-options { margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(15, 23, 42, 0.08); }
.exam-options-heading {
  display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 10px;
}
.count-slider-row { display: flex; gap: 12px; align-items: center; }
.count-slider-row input[type="range"] { flex: 1; }
.count-slider-row input[type="number"] {
  width: 72px; min-height: 40px; border: 1px solid var(--line);
  border-radius: 10px; padding: 0 10px; text-align: center;
}
.exam-type-list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.check-option { display: flex; align-items: center; gap: 8px; font-size: 0.88rem; }
.field-hint { color: var(--muted); font-size: 0.78rem; margin-top: 6px; }
.field-label { font-size: 0.78rem; font-weight: 800; }
.exam-type-fieldset {
  border: 1px solid rgba(15, 23, 42, 0.1); border-radius: 12px; padding: 12px 14px; margin: 0;
}
.site-footer {
  border-top: 1px solid var(--line); padding: 18px 0 28px; color: var(--muted); font-size: 0.84rem;
}

@media (max-width: 860px) {
  .workspace { grid-template-columns: 1fr; }
  .settings-grid, .generator-grid, .dual-key-grid, .provider-help-grid {
    grid-template-columns: 1fr;
  }
  .custom-topic-field { grid-column: auto; }
  .summary-grid { grid-template-columns: 1fr; }
  .exam-type-list { grid-template-columns: 1fr; }
}
@media (max-width: 560px) {
  .flashcard, .flashcard-face { min-height: 255px; }
  .rating-row { flex-direction: column; align-items: stretch; }
  .rating-row .button { width: 100%; }
  .output-actions { justify-content: flex-start; }
  .score-row, .score-panel { grid-template-columns: 1fr; }
  .exam-actions { flex-direction: column; }
  .exam-actions .button { width: 100%; }
  .weak-topic { flex-direction: column; gap: 3px; }
  .weak-topic span { text-align: left; }
  .action-row { flex-direction: column; }
  .action-row .button { width: 100%; }
}

@media print {
  body { background: #fff; }
  .site-header, .hero, .privacy-note, .workspace, .ai-card, .generate-card, .preview-card,
  .site-footer, .status-pill, .dropzone, .action-row { display: none !important; }
  .card { box-shadow: none; border: 0; padding: 0; }
  body.print-exam .output-actions .button, body.print-summary .output-actions .button,
  body.print-exam .exam-actions, body.print-exam .exam-intro { display: none !important; }
  body.print-exam .exam-results { margin-top: 18px; }
  body.print-exam .exam-question, body.print-exam .choice-option,
  body.print-summary .summary-section, body.print-summary .summary-box,
  body.print-summary .self-check { break-inside: avoid; }
  body.print-summary .card-heading { margin-bottom: 10px; }
}
